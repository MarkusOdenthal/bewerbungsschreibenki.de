---
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Contact'
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact" title="Get In Touch" />

  <ContactUs
    id="form"
    title="Send us a message"
    subtitle="Have a question or need help? Fill out the form below and we will get back to you as soon as possible."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name'
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email'
      }
    ]}
    textarea={{
      label: 'Message'
    }}
    disclaimer={{
      label:
        'By submitting this contact form, you acknowledge and agree to the collection of your personal information.'
    }}
    description="We typically respond within 24 business hours."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Other ways to reach us"
    items={[
      {
        title: 'General inquiries',
        description: 'Describe your general support options here.'
      },
      {
        title: 'Sales',
        description: 'Describe how potential customers can reach your sales team.'
      },
      {
        title: 'Technical support',
        description: 'Describe your technical support channels and response times.'
      },
      {
        title: 'Phone',
        description: '+1 (234) 567-890',
        icon: 'tabler:headset'
      },
      {
        title: 'Email',
        description: 'hello@yourcompany.com',
        icon: 'tabler:mail'
      },
      {
        title: 'Location',
        description: 'Your City, Your Country',
        icon: 'tabler:map-pin'
      }
    ]}
  />
</Layout>
