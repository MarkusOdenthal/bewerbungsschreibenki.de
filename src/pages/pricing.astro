---
import CallToAction from '~/components/widgets/CallToAction.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Features3 from '~/components/widgets/Features3.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import Steps from '~/components/widgets/Steps.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Pricing'
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="Pricing"
    title="Simple, Transparent Pricing"
    subtitle="Choose the plan that fits your needs. No hidden fees."
  />

  <!-- Pricing Widget ******************* -->

  <Prices
    title="Our plans"
    subtitle="Pay only for what you need"
    prices={[
      {
        title: 'starter',
        subtitle: 'Best for individuals',
        price: 19,
        period: 'per month',
        items: [
          {
            description: 'Describe included feature one'
          },
          {
            description: 'Describe included feature two'
          },
          {
            description: 'Describe included feature three'
          },
          {
            description: 'Describe included feature four'
          }
        ],
        callToAction: {
          text: 'Get started',
          href: '#'
        }
      },
      {
        title: 'professional',
        subtitle: 'Best for small teams',
        price: 49,
        period: 'per month',
        items: [
          {
            description: 'Everything in Starter, plus:'
          },
          {
            description: 'Describe additional feature one'
          },
          {
            description: 'Describe additional feature two'
          },
          {
            description: 'Describe additional feature three'
          },
          {
            description: 'Describe additional feature four'
          }
        ],
        callToAction: {
          text: 'Get started',
          href: '#stripe-checkout'
        },
        hasRibbon: true,
        ribbonTitle: 'popular'
      },
      {
        title: 'enterprise',
        subtitle: 'Best for organizations',
        price: 149,
        period: 'per month',
        items: [
          {
            description: 'Everything in Professional, plus:'
          },
          {
            description: 'Describe premium feature one'
          },
          {
            description: 'Describe premium feature two'
          },
          {
            description: 'Describe premium feature three'
          }
        ],
        callToAction: {
          text: 'Contact sales',
          href: '/contact'
        }
      }
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Why our customers love us"
    subtitle="Benefits that come with every plan"
    columns={2}
    items={[
      {
        title: 'Flexible Plans',
        description: 'Choose from a range of plans designed to accommodate different budgets and requirements.',
        icon: 'tabler:stairs'
      },
      {
        title: 'Transparent Pricing',
        description: 'No hidden costs or unexpected charges. What you see is what you pay.',
        icon: 'tabler:flip-vertical'
      },
      {
        title: 'Secure Payments',
        description: 'All payments are processed securely through Stripe.',
        icon: 'tabler:shield-lock'
      },
      {
        title: 'Instant Access',
        description: 'Get immediate access to all features upon subscription.',
        icon: 'tabler:accessible'
      },
      {
        title: 'Easy Upgrades',
        description: 'Upgrade or downgrade your plan at any time as your needs change.',
        icon: 'tabler:chevrons-up'
      },
      {
        title: 'Priority Support',
        description: 'Get help when you need it via email, chat, or phone.',
        icon: 'tabler:headset'
      }
    ]}
    classes={{ container: 'max-w-5xl' }}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="How to get started"
    tagline="Simple process"
    isReversed={true}
    items={[
      {
        title: 'Choose your plan',
        icon: 'tabler:number-1'
      },
      {
        title: 'Create your account',
        icon: 'tabler:number-2'
      },
      {
        title: 'Enter payment details',
        icon: 'tabler:number-3'
      },
      {
        title: 'Start using your product',
        icon: 'tabler:number-4'
      }
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1536816579748-4ecb3f03d72a?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Steps image'
    }}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Pricing FAQs"
    subtitle="Common questions about our pricing and plans."
    columns={1}
    items={[
      {
        title: 'Do the plans come with customer support?',
        description: 'Yes, all plans include access to our customer support team.'
      },
      {
        title: 'Is there a free trial?',
        description: 'Describe your free trial or money-back guarantee policy here.'
      },
      {
        title: 'Can I switch between plans?',
        description: 'Yes, you can upgrade or downgrade your plan at any time.'
      },
      {
        title: 'What payment methods do you accept?',
        description: 'We accept all major credit cards through Stripe. Additional payment methods may be available.'
      },
      {
        title: 'Are there any hidden fees?',
        description: 'No. The subscription cost covers all features listed under each plan. There are no hidden fees.'
      }
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="Ready to get started?"
    subtitle="Join our growing community of satisfied customers."
    actions={[
      {
        variant: 'primary',
        text: 'Choose your plan',
        href: '#'
      }
    ]}
  />
</Layout>
