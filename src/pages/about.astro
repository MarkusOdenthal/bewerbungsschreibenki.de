---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About us'
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About us"
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'About Us Image'
    }}
  >
    <Fragment slot="title">
      About <span class="text-accent dark:text-white">Your Company</span>
    </Fragment>

    <Fragment slot="subtitle">
      Describe your company's mission and vision here. Explain what drives your team and why you built this product.
      Keep it authentic and customer-focused.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Our impact in numbers"
    stats={[
      { title: 'Customers', amount: '500+' },
      { title: 'Team Members', amount: '10' },
      { title: 'Years in Business', amount: '3' },
      { title: 'Customer Satisfaction', amount: '98%' }
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="What we offer"
    subtitle="Describe the range of products or services you provide. Highlight what makes each one valuable."
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'Service One',
        description: 'Describe your first service or product offering and how it benefits customers.',
        icon: 'tabler:template'
      },
      {
        title: 'Service Two',
        description: 'Describe your second service or product offering and its unique value.',
        icon: 'tabler:template'
      },
      {
        title: 'Service Three',
        description: 'Describe your third service or product offering and why customers choose it.',
        icon: 'tabler:template'
      }
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: 'Service Four',
        description: 'Describe additional services or product lines you offer.',
        icon: 'tabler:template'
      },
      {
        title: 'Service Five',
        description: 'Describe another offering and its key benefits.',
        icon: 'tabler:template'
      },
      {
        title: 'Service Six',
        description: 'Describe your final service offering and what sets it apart.',
        icon: 'tabler:template'
      }
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: 'Team working image'
    }}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Our values"
    subtitle="These core values guide everything we do as a company."
    items={[
      {
        title: 'Customer First',
        description: 'Describe your first core value and how it shapes your company culture and decisions.'
      },
      {
        title: 'Continuous Improvement',
        description: 'Describe your second core value and give an example of how you live it.'
      },
      {
        title: 'Transparency',
        description: 'Describe your third core value and why it matters to your team and customers.'
      }
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Achievements"
    subtitle="Milestones and accomplishments that we are proud of."
    isReversed={true}
    callToAction={{
      text: 'Learn more',
      href: '/'
    }}
    items={[
      {
        title: 'Achievement One',
        description: 'Describe a key milestone or accomplishment your company has reached.',
        icon: 'tabler:globe'
      },
      {
        title: 'Achievement Two',
        description: 'Describe another important achievement, such as customer growth or product launches.',
        icon: 'tabler:message-star'
      },
      {
        title: 'Achievement Three',
        description: 'Describe an award, recognition, or significant business milestone.',
        icon: 'tabler:award'
      }
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Get in touch"
    tagline="Contact"
    columns={2}
    items={[
      {
        title: 'Chat with us',
        description: 'Describe your primary support channel and availability.',
        icon: 'tabler:messages'
      },
      {
        title: 'Email us',
        description: 'Provide your contact email or describe how customers can reach you.',
        icon: 'tabler:headset'
      }
    ]}
  />
</Layout>
