---
import CallToAction from '~/components/widgets/CallToAction.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import Layout from '~/layouts/LandingLayout.astro';

const metadata = {
  title: 'Subscription Landing Page Demo'
};
---

<Layout metadata={metadata}>
  <Hero2
    tagline="Subscription Demo"
    title="Convert Visitors into Loyal Subscribers"
    subtitle="This is a demo subscription landing page. Replace this with compelling content about your subscription offering."
    actions={[
      { variant: 'primary', text: 'Subscribe Now', href: '/pricing', icon: 'tabler:square-rounded-arrow-right' },
      { text: 'Learn more', href: '#' }
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1593510987046-1f8fcfc512a0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Subscription landing page demo'
    }}
  />

  <CallToAction
    title="Ready to customize?"
    subtitle="Replace this demo content with your subscription benefits and pricing."
    actions={[
      {
        variant: 'primary',
        text: 'Get Started',
        href: '/pricing',
        icon: 'tabler:arrow-right'
      }
    ]}
  />
</Layout>
