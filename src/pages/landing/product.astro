---
import CallToAction from '~/components/widgets/CallToAction.astro';

import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/LandingLayout.astro';

const metadata = {
  title: 'Product Details Landing Page Demo'
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Product Details Demo"
    title="Showcase Your Product with Precision"
    subtitle="This is a demo product details landing page. Replace this with detailed information about your product or service."
    actions={[
      { variant: 'primary', text: 'Get Started', href: '/pricing', icon: 'tabler:square-rounded-arrow-right' },
      { text: 'Learn more', href: '#' }
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1473188588951-666fce8e7c68?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2174&q=80',
      alt: 'Product details landing page demo'
    }}
  />

  <CallToAction
    title="Ready to customize?"
    subtitle="Replace this demo content with your product details, features, and specifications."
    actions={[
      {
        variant: 'primary',
        text: 'Get Started',
        href: '/pricing',
        icon: 'tabler:arrow-right'
      }
    ]}
  />
</Layout>
