---
import CallToAction from '~/components/widgets/CallToAction.astro';

import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/LandingLayout.astro';

const metadata = {
  title: 'Lead Generation Landing Page Demo'
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Lead Generation Demo"
    title="Capture Leads with a Compelling Landing Page"
    subtitle="This is a demo lead generation landing page. Replace this content with your own headline and value proposition to convert visitors into leads."
    actions={[
      { variant: 'primary', text: 'Get Started', href: '/pricing', icon: 'tabler:square-rounded-arrow-right' },
      { text: 'Learn more', href: '#' }
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1597423498219-04418210827d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1674&q=80',
      alt: 'Lead generation landing page demo'
    }}
  />

  <CallToAction
    title="Ready to customize?"
    subtitle="Replace this demo content with your own messaging, forms, and calls to action."
    actions={[
      {
        variant: 'primary',
        text: 'Get Started',
        href: '/pricing',
        icon: 'tabler:arrow-right'
      }
    ]}
  />
</Layout>
