---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Services'
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Services"
    title="What we offer"
    subtitle="Explore our range of services designed to help you achieve your goals. Each service is tailored to deliver measurable results."
    actions={[{ variant: 'primary', text: 'Get started', href: '/pricing' }]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: 'Services Hero Image'
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Our services"
    subtitle="Choose the service that fits your needs."
    columns={3}
    items={[
      {
        title: 'Service One',
        description:
          'Describe your first service. Focus on the value it provides and the problems it solves for customers.',
        icon: 'tabler:school'
      },
      {
        title: 'Service Two',
        description: 'Describe your second service. Highlight what makes it unique and why customers should choose it.',
        icon: 'tabler:home-star'
      },
      {
        title: 'Service Three',
        description: 'Describe your third service and the outcomes customers can expect.',
        icon: 'tabler:photo'
      },
      {
        title: 'Service Four',
        description: 'Describe your fourth service. Include any relevant details about pricing or availability.',
        icon: 'tabler:shopping-cart'
      },
      {
        title: 'Service Five',
        description: 'Describe your fifth service and how it complements the others.',
        icon: 'tabler:article'
      },
      {
        title: 'Service Six',
        description: 'Describe your sixth service. Consider mentioning a customer success story.',
        icon: 'tabler:building-store'
      }
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    items={[
      {
        title: 'Quality',
        description: 'Describe the quality standards you maintain and how they benefit your customers.',
        icon: 'tabler:wand'
      },
      {
        title: 'Customization',
        description: 'Describe how your services can be tailored to individual customer needs.',
        icon: 'tabler:settings'
      },
      {
        title: 'Fast delivery',
        description: 'Describe your turnaround times and delivery process.',
        icon: 'tabler:presentation'
      },
      {
        title: 'Ongoing support',
        description: 'Describe the post-service support you provide to customers.',
        icon: 'tabler:carousel-horizontal'
      }
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1525909002-1b05e0c869d8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=870&q=80',
      alt: 'Features Image'
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Why choose us</h3>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Save time',
        description: 'Describe how your services save customers time compared to alternatives.',
        icon: 'tabler:clock'
      },
      {
        title: 'Professional results',
        description: 'Describe the quality of outcomes customers can expect.',
        icon: 'tabler:school'
      },
      {
        title: 'Cost-effective',
        description: 'Describe the value proposition and how customers save money with your services.',
        icon: 'tabler:coin'
      },
      {
        title: 'Quick start',
        description: 'Describe how quickly customers can start benefiting from your services.',
        icon: 'tabler:file-download'
      }
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1552664688-cf412ec27db2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
      alt: 'Benefits Image'
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Benefits</h3>
    </Fragment>
  </Content>

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="What our customers say"
    testimonials={[
      {
        testimonial: 'Replace this with a real customer testimonial about your services.',
        name: 'Customer Name',
        job: 'Job Title',
        image: {
          src: 'https://images.unsplash.com/photo-1618835962148-cf177563c6c0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=930&q=80',
          alt: 'Customer Image'
        }
      },
      {
        testimonial: 'Replace this with another customer testimonial highlighting different benefits.',
        name: 'Customer Name',
        job: 'Job Title',
        image: {
          src: 'https://images.unsplash.com/photo-1561406636-b80293969660?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
          alt: 'Customer Image'
        }
      },
      {
        testimonial: 'Replace this with a third customer testimonial to add social proof.',
        name: 'Customer Name',
        job: 'Job Title',
        image: {
          src: 'https://images.unsplash.com/photo-1545167622-3a6ac756afa4?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=824&q=80',
          alt: 'Customer Image'
        }
      }
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get started',
        href: '/pricing'
      }
    ]}
    title="Ready to work with us?"
    subtitle="Contact us today to discuss how we can help you achieve your goals."
  />
</Layout>
