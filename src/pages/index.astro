---
import CallToAction from '~/components/widgets/CallToAction.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Features from '~/components/widgets/Features.astro';
import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Steps from '~/components/widgets/Steps.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'BewerbungsschreibenKI — Professionelle Bewerbung per KI in Minuten',
  ignoreTitleTemplate: true
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Jetzt kaufen — €39',
        href: '/preise',
        icon: 'tabler:arrow-right'
      },
      { text: 'So funktioniert es', href: '#how-it-works' }
    ]}
  >
    <Fragment slot="title">
      Bewerbungsschreiben per KI: <span class="text-accent dark:text-white">In Minuten statt Stunden</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">BewerbungsschreibenKI</span> generiert aus jeder Stellenanzeige ein maßgeschneidertes
        Anschreiben und einen optimierten Lebenslauf — direkt in Claude Desktop.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">KI-Bewerbung in Minuten.</span>
      Stellenanzeige einfügen, Profil einmalig ausfüllen, fertige Bewerbung erhalten. Optimiert für den deutschen Arbeitsmarkt.
    </Fragment>
  </Hero>

  <Note
    title="Warum BewerbungsschreibenKI:"
    description="Keine Abo-Falle. €39 einmalig. Läuft auf deinem eigenen Claude-Account — deine Daten bleiben bei dir."
  />

  <Features
    id="features"
    tagline="Features"
    title="Alles für deine perfekte Bewerbung"
    subtitle="Von der Stellenanzeige zum fertigen Bewerbungspaket — automatisch und auf den deutschen Arbeitsmarkt zugeschnitten."
    items={[
      {
        title: 'Stellenanzeige → Bewerbung',
        description:
          'Füge eine Stellenanzeige ein und erhalte ein maßgeschneidertes Anschreiben, das genau auf die Anforderungen passt.',
        icon: 'tabler:file-text'
      },
      {
        title: 'Optimierter Lebenslauf',
        description:
          'Dein Lebenslauf wird automatisch auf die Stelle zugeschnitten — relevante Erfahrungen hervorgehoben, Lücken geschlossen.',
        icon: 'tabler:list-check'
      },
      {
        title: 'DIN 5008 konform',
        description:
          'Alle Dokumente entsprechen der deutschen Norm für Geschäftsbriefe — professionell und korrekt formatiert.',
        icon: 'tabler:certificate'
      },
      {
        title: 'Branchenspezifisch',
        description:
          'IT, Marketing, Finance, Ausbildung — das Plugin kennt die Anforderungen deiner Branche und passt Ton und Inhalt an.',
        icon: 'tabler:building'
      },
      {
        title: 'Einmalig €39',
        description: 'Kein Abo, keine versteckten Kosten. Einmal kaufen, unbegrenzt Bewerbungen generieren.',
        icon: 'tabler:coin'
      },
      {
        title: 'Deine Daten, dein Account',
        description:
          'Das Plugin läuft auf deinem eigenen Claude-Account. Keine Daten werden an Dritte übertragen — DSGVO-freundlich.',
        icon: 'tabler:shield-lock'
      }
    ]}
  />

  <Steps
    id="how-it-works"
    title="In 3 Schritten zur fertigen Bewerbung"
    items={[
      {
        title: 'Schritt 1: <span class="font-medium">Plugin installieren</span>',
        description: 'Lade das Plugin herunter und installiere es in Claude Desktop. Dauert unter 2 Minuten.',
        icon: 'tabler:download'
      },
      {
        title: 'Schritt 2: <span class="font-medium">Profil ausfüllen</span>',
        description:
          'Fülle einmalig dein Profil aus — Berufserfahrung, Ausbildung, Skills. Das Plugin führt dich durch den Prozess.',
        icon: 'tabler:user-edit'
      },
      {
        title: 'Schritt 3: <span class="font-medium">Stellenanzeige einfügen</span>',
        description: 'Kopiere eine Stellenanzeige, das Plugin generiert Anschreiben + Lebenslauf. Fertig.',
        icon: 'tabler:sparkles'
      },
      {
        title: 'Bewerbung abschicken!',
        icon: 'tabler:check'
      }
    ]}
  />

  <FAQs
    title="Häufig gestellte Fragen"
    subtitle="Alles was du über BewerbungsschreibenKI wissen musst."
    tagline="FAQ"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Was ist BewerbungsschreibenKI?',
        description:
          'Ein Claude Plugin, das aus Stellenanzeigen professionelle Bewerbungsschreiben und Lebensläufe generiert. Optimiert für den deutschen Arbeitsmarkt mit DIN 5008 Formatierung.'
      },
      {
        title: 'Brauche ich ein Claude-Abo?',
        description:
          'Ja, du brauchst einen Claude Desktop Account (Pro oder Free). Das Plugin läuft auf deinem eigenen Account — deine Daten bleiben bei dir.'
      },
      {
        title: 'Wie unterscheidet sich das von ChatGPT?',
        description:
          'BewerbungsschreibenKI ist speziell für den deutschen Bewerbungsmarkt entwickelt. Es kennt DIN 5008, branchenspezifische Anforderungen und erstellt strukturierte Dokumente statt nur Fließtext.'
      },
      {
        title: 'Ist das ein Abo?',
        description: 'Nein. €39 einmalig, unbegrenzte Nutzung. Keine monatlichen Kosten, kein Kleingedrucktes.'
      },
      {
        title: 'Kann ich das Plugin auch für englische Bewerbungen nutzen?',
        description:
          'Der Fokus liegt auf dem deutschen Markt, aber du kannst das Plugin auch für englischsprachige Bewerbungen einsetzen.'
      },
      {
        title: 'Wie bekomme ich Support?',
        description: 'Per E-Mail an support@bewerbungsschreibenki.de. Antwortzeit in der Regel unter 24 Stunden.'
      }
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Jetzt kaufen — €39',
        href: '/preise',
        icon: 'tabler:arrow-right'
      }
    ]}
  >
    <Fragment slot="title">Bereit für deine nächste Bewerbung?</Fragment>

    <Fragment slot="subtitle">
      Schluss mit stundenlangem Formulieren. Stellenanzeige rein, Bewerbung raus. Einmalig €39.
    </Fragment>
  </CallToAction>
</Layout>
